# Muzo — environment configuration for the distributed Docker Compose stack.
#
# Copy this file to `.env` in the repo root (scripts/install.sh does this for
# you) and fill in the values marked REQUIRED. Everything else has a working
# default or is optional (a feature degrades/stays disabled if left blank).
#
# Hostnames below (postgres/redis/elasticsearch) are the container-network
# names from backend/docker-compose.yml -- correct for running via
# `docker compose up`. If you're running the backend locally without Docker,
# use `localhost` instead for DATABASE_URL/REDIS_HOST/ELASTICSEARCH_NODE.

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=3001

# ---------------------------------------------------------------------------
# Music folder
# ---------------------------------------------------------------------------
# Mounted into the backend container at the SAME path as on your host, so
# absolute filesystem paths (a library's rootPath stored in the DB;
# SOCKSEEK_OUTPUT_DIR/TIDAL_OUTPUT_DIR/PLAYLIST_EXPORT_DIR below) resolve
# correctly without translation. Defaults to ~/Music -- set this if your
# music library, Soulseek downloads, or playlist exports live somewhere
# else (or somewhere outside ~/Music entirely).
# MUSIC_DIR=/Users/you/Music

# ---------------------------------------------------------------------------
# Database (Postgres, via the `postgres` service in backend/docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://muzo:muzo@postgres:5432/muzo
DATABASE_LOGGING=false

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variable -- baked in when the frontend image is
# built, changing it requires `docker compose build frontend` again)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Better Auth (https://better-auth.com) -- REQUIRED
# Generate a secret: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional social sign-on (create OAuth apps on Google Cloud Console / GitHub Developer Settings)
# BETTER_AUTH_GOOGLE_CLIENT_ID=
# BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_GITHUB_CLIENT_ID=
# BETTER_AUTH_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------------------
PRISMA_GENERATE_ENGINE=true

# ---------------------------------------------------------------------------
# AI Service -- REQUIRED for AI analysis features (genre/BPM/key/mood/etc).
# The mode/URL/token/replica count below are only a FIRST-BOOT seed: once the
# app starts, this is all controlled live from Settings in the UI (mode
# switch, remote URL+token with a "Test connection" check, replica stepper)
# and the .env values here stop being read. Leave AI_SERVICE_URL blank and
# the app still runs, just without AI analysis, until you configure a mode
# in Settings.
#
# AI_SERVICE_URL / AI_SERVICE_TOKEN -- seeds REMOTE mode: a Hugging Face
# Inference Endpoint (or any host implementing the same API) you deploy
# yourself. See ai-service/docker/deploy-hf.sh.
#
# AI_SERVICE_REPLICAS / AI_WEB_CONCURRENCY / AI_ANALYSIS_THREADS -- only used
# in LOCAL mode (the `ai-service` compose service, started under the
# `local-ai` profile). Local scaling happens live from Settings via the
# Docker socket the backend mounts -- see docker-compose.yml's comments on
# that tradeoff. Keep replicas * AI_WEB_CONCURRENCY * AI_ANALYSIS_THREADS
# within your Docker Desktop VM's CPU budget, and replicas *
# AI_WEB_CONCURRENCY * ~2.5GB within its memory budget.
#
# Third-party API keys the ai-service uses (Gemini / Hugging Face / Last.fm /
# Discogs) are set from Settings > AI Service in the app -- in LOCAL mode the
# backend injects them into the container and an "Apply" button reloads it.
# The `ai-service.environment:` entries in docker-compose.yml are only the
# boot default; a remote endpoint reads its own environment.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=120000
AI_BATCH_CONCURRENCY=5
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000
AI_SERVICE_MODE=remote
AI_SERVICE_REPLICAS=1
AI_WEB_CONCURRENCY=1
AI_ANALYSIS_THREADS=4

# ---------------------------------------------------------------------------
# Elasticsearch (recommendation engine)
# ---------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis (queues, caching, scan progress)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Queue tuning (safe defaults, adjust if scans are too slow/fast for your machine)
# ---------------------------------------------------------------------------
LIBRARY_SCAN_CONCURRENCY=2
LIBRARY_SCAN_ATTEMPTS=3
LIBRARY_SCAN_BACKOFF_DELAY=2000
AUDIO_SCAN_CONCURRENCY=5
AUDIO_SCAN_ATTEMPTS=3
AUDIO_SCAN_BACKOFF_DELAY=1000
EMBEDDING_BACKFILL_CONCURRENCY=2
EMBEDDING_BACKFILL_ATTEMPTS=3
EMBEDDING_BACKFILL_BACKOFF_DELAY=2000
# HQ_AUDIO_ACQUIRE_ATTEMPTS=2
# HQ_AUDIO_ACQUIRE_BACKOFF_DELAY=3000
# HQ_AUDIO_BATCH_ACQUIRE_CONCURRENCY=5
# HQ_AUDIO_BATCH_ACQUIRE_ATTEMPTS=2
# HQ_AUDIO_BATCH_ACQUIRE_BACKOFF_DELAY=3000

# Optional: recommendation-engine kill-switch. The embedding cosine similarity
# is always the score base; set to false to disable it and fall back to
# criteria-only scoring (diagnostic use only -- ranking is much weaker without
# the embedding base).
# ELASTICSEARCH_EMBEDDING_VECTOR_SIMILARITY=true

# Optional: Redis pub/sub channel prefixes (rarely need changing)
# REDIS_SCAN_CHANNEL_PREFIX=scan:session
# REDIS_HQ_AUDIO_BATCH_CHANNEL_PREFIX=hq-audio-batch

# ---------------------------------------------------------------------------
# Playlist export
# ---------------------------------------------------------------------------
# Where "Download HQ" / playlist export writes files, inside the backend
# container. Defaults to ~/Music/muzo-exports if left blank.
PLAYLIST_EXPORT_DIR=

# ---------------------------------------------------------------------------
# HQ audio acquisition -- Soulseek (via the local `sockseek` CLI binary,
# installed by scripts/install.sh -- see https://github.com/fiso64/sockseek)
# ---------------------------------------------------------------------------
SOCKSEEK_BINARY_PATH=sockseek
# Path to your own sockseek config (Soulseek account credentials) -- never
# committed, supply your own.
SOCKSEEK_CONFIG_PATH=
SOCKSEEK_TIMEOUT_MS=120000
SOCKSEEK_BATCH_BASE_TIMEOUT_MS=120000
SOCKSEEK_BATCH_PER_TRACK_TIMEOUT_MS=30000
# SOCKSEEK_FAST_SEARCH=false
# SOCKSEEK_SEARCH_TIMEOUT_MS=30000
# Where downloaded Soulseek files are saved. Placeholder -- set to a real
# path on your machine (e.g. ~/Music/Soulseek).
SOCKSEEK_OUTPUT_DIR=
# Path to Nicotine+'s data dir, if you also run it -- only used to check
# whether Nicotine+ is running before a sockseek acquisition.
# NICOTINE_PLUS_DATA_DIR=

# HQ audio acquisition -- Tidal output directory. Placeholder -- set to a
# real path on your machine (e.g. ~/Music/Tidal).
TIDAL_OUTPUT_DIR=

# HQ audio acquisition -- Universr (audio enhancement) output directory and
# job timeout. Placeholder -- set to a real path (e.g. ~/Music/Enhanced).
# UNIVERSR_OUTPUT_DIR=
# UNIVERSR_TIMEOUT_MS=2400000

# ---------------------------------------------------------------------------
# Optional: cosine.club (playlist discovery) -- https://cosine.club/account
# ---------------------------------------------------------------------------
COSINE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: Tidal OAuth2 sync -- https://developer.tidal.com/
# ---------------------------------------------------------------------------
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=http://localhost:3000
TIDAL_COUNTRY_CODE=US

# ---------------------------------------------------------------------------
# Optional: YouTube OAuth2 sync -- https://console.cloud.google.com/
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: Spotify OAuth2 sync -- https://developer.spotify.com/dashboard
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000
