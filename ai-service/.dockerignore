.git
.venv
__pycache__
*.pyc
.pytest_cache
.DS_Store
.env
.env.template
docker
htmlcov
coverage.xml
temp_segments
# Exclude the models dir, but keep the pre-downloaded essentia model cache so the
# image ships with it -- otherwise every fresh HF replica re-downloads ~35 MB of
# .pb files from essentia.upf.edu on its first request (and again after any
# replica restart, since the disk cache is ephemeral).
models
!models/essentia_cache
!models/essentia_cache/**
tests
*.md
.claude
.cursor
specs.md
# trainers/ is training-time code, but the filename_parser package is needed at
# runtime: SimpleFilenameParser loads HybridFilenameParser + the sklearn pickles
# in filename_models/. Ship only that package (minus its training-only files).
trainers
!trainers/__init__.py
!trainers/filename_parser/
trainers/filename_parser/*.md
trainers/filename_parser/comprehensive_test.py
trainers/filename_parser/train.py
trainers/filename_parser/__pycache__
