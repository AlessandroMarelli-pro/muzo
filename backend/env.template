# Database Configuration (Prisma + SQLite/Turso)
DATABASE_URL=file:./muzo.db
DATABASE_LOGGING=false

# Server Configuration
PORT=3000
NODE_ENV=development

# GraphQL Configuration
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Better Auth (https://better-auth.com)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: social sign-on (create OAuth apps on Google Cloud Console / GitHub Developer Settings)
# BETTER_AUTH_GOOGLE_CLIENT_ID=
# BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_GITHUB_CLIENT_ID=
# BETTER_AUTH_GITHUB_CLIENT_SECRET=

# Prisma Configuration
PRISMA_GENERATE_ENGINE=true

# AI Service Configuration
AI_SERVICE_URL=http://localhost:4000
# Bearer token required only when AI_SERVICE_URL points at an authenticated
# endpoint (e.g. a Hugging Face Inference Endpoint) -- leave blank for a
# local, unauthenticated ai-service instance.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=30000
AI_BATCH_CONCURRENCY=5
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Redis Configuration (Docker container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Configuration
LIBRARY_SCAN_CONCURRENCY=2
LIBRARY_SCAN_ATTEMPTS=3
LIBRARY_SCAN_BACKOFF_DELAY=2000
AUDIO_SCAN_CONCURRENCY=5
AUDIO_SCAN_ATTEMPTS=3
AUDIO_SCAN_BACKOFF_DELAY=1000
HQ_AUDIO_ACQUIRE_ATTEMPTS=2
HQ_AUDIO_ACQUIRE_BACKOFF_DELAY=3000

# Scan Progress Configuration
SCAN_PROGRESS_UPDATE_INTERVAL=0
SCAN_SESSION_TTL=86400
REDIS_SCAN_CHANNEL_PREFIX=scan:session

# HQ Audio acquisition
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
SLSKD_DOWNLOAD_PATH=
SLSKD_SEARCH_TIMEOUT_MS=30000

# Sockseek CLI (native binary, used by HqAudioInfrastructureModule for Soulseek downloads)
# Credentials live in the sockseek config file (see SOCKSEEK_CONFIG_PATH), not here.
SOCKSEEK_BINARY_PATH=sockseek
SOCKSEEK_CONFIG_PATH=
# Timeout for a single-track acquisition (used by the manual "Download HQ" button)
SOCKSEEK_TIMEOUT_MS=120000
# Timeout for a playlist batch download = base + (per-track * track count)
SOCKSEEK_BATCH_BASE_TIMEOUT_MS=120000
SOCKSEEK_BATCH_PER_TRACK_TIMEOUT_MS=30000
SOCKSEEK_OUTPUT_DIR=/Users/alessandro/Music/Soulseek

# Tidal HQ acquisition output directory
TIDAL_OUTPUT_DIR=/Users/alessandro/Music/Tidal

# TIDAL OAuth2 Configuration
# Get these from https://developer.tidal.com/
# IMPORTANT: The redirect URI must match exactly what's configured in your TIDAL Developer Portal
# If TIDAL redirects to https://tidal-music.github.io/tidal-api-reference/oauth2-redirect.html,
# set TIDAL_REDIRECT_URI to that URL, or configure http://localhost:3000 in the TIDAL Developer Portal
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=http://localhost:3000
# ISO 3166-1 alpha-2 country code used to scope search/track availability
TIDAL_COUNTRY_CODE=US

# YouTube OAuth2 Configuration
# Get these from https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000

# Spotify OAuth2 Configuration
# Get these from https://developer.spotify.com/dashboard
# IMPORTANT: The redirect URI must match exactly what's configured in your Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000
