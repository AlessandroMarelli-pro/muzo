// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Core Entities

model MusicLibrary {
  id                    String   @id @default(uuid())
  name                  String
  rootPath              String
  totalTracks           Int      @default(0)
  analyzedTracks        Int      @default(0)
  pendingTracks         Int      @default(0)
  failedTracks          Int      @default(0)
  lastScanAt            DateTime?
  lastIncrementalScanAt DateTime?
  scanStatus            ScanStatus @default(IDLE)
  
  // Settings
  autoScan              Boolean  @default(true)
  scanInterval          Int?     // in hours
  includeSubdirectories Boolean  @default(true)
  supportedFormats      String   @default("MP3,FLAC,WAV,AAC,OGG,OPUS,M4A") // comma-separated
  maxFileSize           Int?     // in MB
  
  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  tracks                MusicTrack[]
  hiddenTracks          HiddenMusicTrack[]
  
  @@map("music_libraries")
}

model MusicTrack {
  id                    String   @id @default(uuid())
  filePath              String   @unique
  hqAudioPath           String?
  fileName              String
  fileSize              Int
  format                String
  bitrate               Int?
  sampleRate            Int?
  fileCreatedAt         DateTime @default(now())
  duration              Float

  // Original Metadata
  originalTitle         String?
  originalArtist        String?
  originalAlbum         String?
  originalYear          Int?
  originalAlbumartist   String?
  originalDate          DateTime?
  originalBpm           Int?
  originalTrack_number  Int?
  originalDisc_number   String?
  originalComment       String?
  originalComposer      String?
  originalCopyright     String?

  // AI-Generated Metadata
  aiTitle               String?
  aiArtist              String?
  aiAlbum               String?
  aiConfidence           Float?
  aiSubgenreConfidence   Float?
  aiDescription         String?
  aiTags                String?
  vocalsDesc            String?  // From audioFeatures.vocals
  contextBackground     String?  // From context.background
  contextImpact         String?  // From context.impact
 

  // User Modifications
  userTitle             String?
  userArtist            String?
  userAlbum             String?
  userTags              String?  // JSON array as string
  
  // Listening Data
  listeningCount        Int      @default(0)
  lastPlayedAt          DateTime?
  isFavorite            Boolean @default(false)
  isLiked               Boolean @default(false)
  isBanger              Boolean @default(false)

  // Analysis Status
  analysisStatus        AnalysisStatus @default(PENDING)
  analysisStartedAt     DateTime?
  analysisCompletedAt   DateTime?
  analysisError         String?

  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?


  // Relations
  libraryId             String
  library               MusicLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  audioFingerprint      AudioFingerprint?

  playlistTracks        PlaylistTrack[]
  imageSearches         ImageSearch[]
  trackGenres           TrackGenre[]
  trackSubgenres        TrackSubgenre[]
  trackAiAtmosphereTags TrackAiAtmosphereTag[]
  queue                 Queue?


  // Indexes for query performance
  @@index([libraryId])
  @@index([analysisStatus])
  @@index([isFavorite])
  @@index([format])
  @@index([aiConfidence])
  @@index([createdAt])
  @@index([listeningCount])
  @@index([lastPlayedAt])
  @@index([libraryId, analysisStatus])
  @@index([libraryId, isFavorite])
  @@index([analysisStatus, createdAt])
  @@map("music_tracks")
}

model AudioFingerprint {
  id                    String   @id @default(uuid())
  trackId               String   @unique

  // features.* -- null when the source model did not run (no more 0.0/""/"Unknown" placeholders)
  tempo                 Float?
  tempoConfidence       Float?   // the only feature that carries a model confidence today
  key                   String?
  camelotKey            String?
  mode                  String?
  valence               Float?
  arousal               Float?
  danceability          Float?
  instrumentalness      Float?
  moodHappy             Float?
  moodSad               Float?
  moodRelaxed           Float?
  moodAggressive        Float?
  moodParty             Float?
  voice                 Float?

  // labels.* -- null when their source feature is null
  valenceMood           String?
  arousalMood           String?
  danceabilityFeeling   String?

  // classifications.{instruments,tags} -- JSON arrays (genres/styles are relational, see TrackGenre/TrackSubgenre)
  instruments           String @default("[]") // JSON array of {instrument, confidence} from mtg_jamendo_instrument
  tags                  String @default("[]") // JSON array of {tag, confidence} from mtg_jamendo_top50tags

  // embedding.{vector,dim,source}
  embedding             String @default("[]") // JSON array of `embeddingDim` floats (discogs-effnet)
  embeddingDim          Int?

  // provenance
  schemaVersion         Int    @default(2)
  warnings              String @default("[]") // JSON array of {model, reason, detail} from the ai-service response

  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?

  // Relations
  track                 MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Indexes for query performance (audio features used in filtering and sorting)
  @@index([key])
  @@index([tempo])
  @@index([danceability])
  @@index([valence])
  @@index([arousal])
  @@index([instrumentalness])
  @@map("audio_fingerprints")
}



model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String?  // For V2 multi-user support
  
  // UI Preferences
  theme                 String   @default("system") // light, dark, system
  language              String   @default("en")
  timezone              String   @default("UTC")
  
  // Music Preferences
  defaultVolume         Float    @default(0.7)
  autoPlay              Boolean  @default(false)
  shuffleMode           Boolean  @default(false)
  repeatMode            RepeatMode @default(NONE)
  
  // Analysis Preferences
  autoAnalyze           Boolean  @default(true)
  confidenceThreshold   Float    @default(0.8)
  preferredGenres       String?  // JSON array as string
  
  // Library Preferences
  autoScan              Boolean  @default(true)
  scanInterval          Int      @default(24) // in hours
  includeSubdirectories Boolean  @default(true)
  supportedFormats      String   @default("MP3,FLAC,WAV,AAC,OGG,OPUS,M4A")
  
  // Privacy Preferences
  shareListeningData    Boolean  @default(false)
  shareAnalysisData     Boolean  @default(false)
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("user_preferences")
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String?  // For future multi-user support
  isPublic    Boolean  @default(false)
  isFavorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  tracks      PlaylistTrack[]
  sorting     PlaylistSorting?
  
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?

  // Relations
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  // Indexes for query performance
  @@index([playlistId])
  @@index([position])
  @@unique([playlistId, trackId])
  @@map("playlist_tracks")
}

model ImageSearch {
  id         String   @id @default(uuid())
  trackId    String
  searchUrl  String
  status     ImageSearchStatus @default(PENDING)
  imagePath  String?
  imageUrl   String?
  error      String?
  source     String?
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
    

  // Relations
  track      MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  // Indexes for query performance
  @@index([trackId])
  @@index([status])
  @@map("image_searches")
}

model SavedFilter {
  id        String   @id @default(uuid())
  name      String
  isCurrent Boolean @default(false)

  criteria  String   // JSON string containing filter criteria
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
    

  @@map("saved_filters")
}


// Genre and Subgenre Models

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?

  // Relations
  trackGenres TrackGenre[]
  subgenres   Subgenre[]
  
  @@index([name])
  @@map("genres")
}

model Subgenre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  genreId     String?  // Optional parent genre
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  genre         Genre?         @relation(fields: [genreId], references: [id], onDelete: SetNull)
  trackSubgenres TrackSubgenre[]
  
  @@index([name])
  @@index([genreId])
  @@map("subgenres")
}

model TrackGenre {
  id        String   @id @default(uuid())
  trackId   String
  genreId   String
  confidence Float?  // from classifications.genres[].confidence; null for ID3-derived genres
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  track     MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre     Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)
  
  @@unique([trackId, genreId])
  @@index([trackId])
  @@index([genreId])
  @@map("track_genres")
}

model TrackSubgenre {
  id        String   @id @default(uuid())
  trackId   String
  subgenreId String
  confidence Float?  // from classifications.styles[].confidence
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  track     MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  subgenre  Subgenre   @relation(fields: [subgenreId], references: [id], onDelete: Cascade)
  
  @@unique([trackId, subgenreId])
  @@index([trackId])
  @@index([subgenreId])
  @@map("track_subgenres")
}

// AI Atmosphere Tags (replaces atmosphereDesc when migrated)

model AiAtmosphereTag {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  createdById String   @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById String?

  // Relations
  trackAiAtmosphereTags TrackAiAtmosphereTag[]

  @@index([name])
  @@map("ai_atmosphere_tags")
}

model TrackAiAtmosphereTag {
  id                 String   @id @default(uuid())
  trackId            String
  aiAtmosphereTagId  String
  createdAt          DateTime @default(now())
  createdById        String   @default("userId")
  updatedAt          DateTime? @updatedAt
  updatedById        String?

  // Relations
  track              MusicTrack     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  aiAtmosphereTag    AiAtmosphereTag @relation(fields: [aiAtmosphereTagId], references: [id], onDelete: Cascade)

  @@unique([trackId, aiAtmosphereTagId])
  @@index([trackId])
  @@index([aiAtmosphereTagId])
  @@map("track_ai_atmosphere_tags")
}

model HiddenMusicTrack {
  id                    String   @id @default(uuid())
  filePath              String   @unique
  fileName              String
  fileSize              Int
  duration              Float
  format                String
  bitrate               Int?
  sampleRate            Int?
  
  // Original Metadata
  originalTitle         String?
  originalArtist        String?
  originalAlbum         String?
  originalYear          Int?
  originalAlbumartist   String?
  originalDate          DateTime?
  originalBpm           Int?
  originalTrack_number  Int?
  originalDisc_number   String?
  originalComment       String?
  originalComposer      String?
  originalCopyright     String?

  // AI-Generated Metadata
  aiTitle               String?
  aiArtist              String?
  aiAlbum               String?
  aiConfidence           Float?
  aiSubgenreConfidence   Float?
  aiDescription         String?
  aiTags                String?
  vocalsDesc            String?
  contextBackground     String?
  contextImpact         String?
 
  // User Modifications
  userTitle             String?
  userArtist            String?
  userAlbum             String?
  userTags              String?
  
  // Listening Data
  listeningCount        Int      @default(0)
  lastPlayedAt          DateTime?
  isFavorite            Boolean @default(false)
  isLiked               Boolean @default(false)
  isBanger              Boolean @default(false)

  // Analysis Status
  analysisStatus        AnalysisStatus @default(PENDING)
  analysisStartedAt     DateTime?
  analysisCompletedAt   DateTime?
  analysisError         String?

  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?

  // Relations
  libraryId             String
  library               MusicLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  // Indexes for query performance
  @@index([libraryId])
  @@index([analysisStatus])
  @@index([isFavorite])
  @@index([format])
  @@index([aiConfidence])
  @@index([createdAt])
  @@index([listeningCount])
  @@index([lastPlayedAt])
  @@index([libraryId, analysisStatus])
  @@index([libraryId, isFavorite])
  @@index([analysisStatus, createdAt])
  @@map("hidden_music_tracks")
}

model ThirdPartyOAuthToken {
  id                String   @id @default(uuid())
  provider          String   // 'youtube', 'spotify', 'tidal', etc.
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?  // OAuth scopes
  
  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  

  // Indexes
  @@unique([createdById, provider])
  @@index([createdById])
  @@index([provider])
  @@map("third_party_oauth_tokens")
}

// Enums

enum ScanStatus {
  IDLE
  SCANNING
  ANALYZING
  ERROR
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RepeatMode {
  NONE
  ONE
  ALL
}

enum ImageSearchStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PlaylistSortingKey {
  addedAt
  position
}

enum PlaylistSortingDirection {
  asc
  desc
}

model PlaylistSorting {
  id              String                  @id @default(uuid())
  playlistId      String                  @unique
  sortingKey      PlaylistSortingKey      @default(position)
  sortingDirection PlaylistSortingDirection @default(asc)
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  


  // Relations
  playlist        Playlist                @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  @@map("playlist_sorting")
}

model Queue {
  id        String   @id @default(uuid())
  trackId   String
  position  Int
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?
  
  // Relations
  track     MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  // Indexes
  @@index([trackId])
  @@index([position])
  @@unique([trackId])
  @@map("queue")
}

model ScanSession {
  id                String        @id @default(uuid())
  sessionId         String        @unique // The UUID used for Redis channels
  status            ScanStatus    @default(SCANNING)
  libraryId         String?       // The single library this scan targets; null for cross-library criteria scans
  totalBatches      Int           @default(0)
  completedBatches  Int           @default(0)
  totalTracks       Int           @default(0)
  completedTracks   Int           @default(0)
  failedTracks      Int           @default(0)
  overallProgress   Int           @default(0) // basis-points percentage, 0-10000 (divide by 100 for display %)
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  errorMessage      String?

  // Timestamps
  createdAt   DateTime @default(now())
  createdById   String @default("userId")
  updatedAt   DateTime? @updatedAt
  updatedById  String?

  @@index([sessionId])
  @@index([status])
  @@index([startedAt])
  @@index([libraryId])
  @@map("scan_sessions")
}

// --- Better Auth (https://better-auth.com/docs/concepts/database#core-schema) ---
// Custom table names via @@map; Prisma model names (User, Session, Account, Verification)
// match what the Better Auth Prisma adapter expects (prisma.user, prisma.session, etc.).

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verification")
}
